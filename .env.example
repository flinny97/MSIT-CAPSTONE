# Copy these into your environment to change the app's settings.
# Nothing here is required for running on your own computer.
CAPSTONE_DB_PATH=instance/capstone.db
CAPSTONE_SCREENSHOT_DIR=instance/screenshots
CAPSTONE_SECRET_KEY=change-this-on-a-real-server
CAPSTONE_DEBUG=0
# Researcher dashboard password. Leave it empty on your own computer (the dashboard
# then only opens locally). Always set a long password on a real server.
CAPSTONE_ADMIN_PASSWORD=
PORT=5000
